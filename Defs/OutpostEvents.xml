<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <DreamsOutposts.OutpostEventCategoryDef>
	<defName>DreamsOutposts_Frontier</defName>
	<label>frontier</label>
	<baseWeight>14</baseWeight>
  </DreamsOutposts.OutpostEventCategoryDef>
  <DreamsOutposts.OutpostEventCategoryDef>
    <defName>DreamsOutposts_Industrial</defName>
    <label>industrial</label>
	<baseWeight>0</baseWeight>
  </DreamsOutposts.OutpostEventCategoryDef>
  <DreamsOutposts.OutpostEventCategoryDef>
	<defName>DreamsOutposts_Trade</defName>
	<label>trade</label>
	<baseWeight>0</baseWeight>
	</DreamsOutposts.OutpostEventCategoryDef>
  <DreamsOutposts.OutpostEventCategoryDef>
	<defName>DreamsOutposts_Population</defName>
	<label>population</label>
	<baseWeight>1</baseWeight>
	</DreamsOutposts.OutpostEventCategoryDef>
  <DreamsOutposts.OutpostEventCategoryDef>
	<defName>DreamsOutposts_Research</defName>
	<label>research</label>
	<baseWeight>2</baseWeight>
  </DreamsOutposts.OutpostEventCategoryDef>
  <DreamsOutposts.OutpostEventDef>
    <defName>DO_TestEvent</defName>
    <label>test outpost event</label>
    <description>A minimal outpost event used to verify event definitions load correctly.</description>
    <category>DreamsOutposts_Industrial</category>
    <weight>1</weight>
    <options>
      <li>
        <id>optionA</id>
        <label>Option A</label>
        <description>Receive a small compensation.</description>
        <effects>
          <li Class="DreamsOutposts.OutpostEventEffect_AddItem">
            <thingDef>Steel</thingDef>
            <count>50</count>
          </li>
        </effects>
      </li>
      <li>
        <id>optionB</id>
        <label>Option B</label>
        <description>Pay 100 Steel to improve everyone's mining skill.</description>
        <requirements>
          <li Class="DreamsOutposts.OutpostEventRequirement_ItemCount">
            <thingDef>Steel</thingDef>
            <count>100</count>
          </li>
        </requirements>
        <effects>
          <li Class="DreamsOutposts.OutpostEventEffect_RemoveItem">
            <thingDef>Steel</thingDef>
            <count>100</count>
          </li>
          <li Class="DreamsOutposts.OutpostEventEffect_ImproveSkill">
            <skillDef>Mining</skillDef>
            <levels>5</levels>
          </li>
        </effects>
      </li>
      <li>
        <id>optionC</id>
        <label>Option C</label>
        <description>Choose this only when the outpost has strong mining capacity.</description>
        <requirements>
          <li Class="DreamsOutposts.OutpostEventRequirement_StatValue">
            <stat>MiningSpeed</stat>
            <minValue>1</minValue>
          </li>
        </requirements>
        <effects>
          <li Class="DreamsOutposts.OutpostEventEffect_AddItem">
            <thingDef>Steel</thingDef>
            <count>100</count>
          </li>
        </effects>
      </li>
    </options>
    <defaultOptionId>optionA</defaultOptionId>
    <durationTicks>60000</durationTicks>
  </DreamsOutposts.OutpostEventDef>
  <DreamsOutposts.OutpostEventDef>
    <defName>DO_DelayedEventA</defName>
    <label>delayed request</label>
    <description>A neighbouring settlement asks the outpost for a promise. Whatever you answer, something will come of it later.</description>
    <category>DreamsOutposts_Industrial</category>
    <weight>1</weight>
    <options>
      <li>
        <id>accept</id>
        <label>Agree to their request</label>
        <description>Give them your word. It will be a few days before that promise comes back around.</description>
        <effects>
          <li Class="DreamsOutposts.OutpostEventEffect_ScheduleEvent">
            <eventDef>DO_DelayedEventB</eventDef>
            <delayTicksRange>180000~300000</delayTicksRange> <!-- 3 to 5 days -->
          </li>
        </effects>
      </li>
      <li>
        <id>driveOff</id>
        <label>Drive them off by force</label>
        <description>Show them the outpost is not worth arguing with.</description>
        <requirements>
          <li Class="DreamsOutposts.OutpostEventRequirement_MinDefense">
            <minDefense>30</minDefense>
          </li>
        </requirements>
        <effects>
          <li Class="DreamsOutposts.OutpostEventEffect_AddItem">
            <thingDef>Steel</thingDef>
            <count>100</count>
          </li>
        </effects>
      </li>
    </options>
    <defaultOptionId>accept</defaultOptionId>
    <durationTicks>60000</durationTicks>
  </DreamsOutposts.OutpostEventDef>
  <DreamsOutposts.OutpostEventDef>
    <defName>DO_DelayedEventB</defName>
    <label>their side of the bargain</label>
    <description>They kept their word. A shipment arrives at the outpost, a few days after you gave yours.</description>
    <category>DreamsOutposts_Industrial</category>
    <weight>0</weight>
    <options>
      <li>
        <id>default</id>
        <label>Continue</label>
        <playerSelectable>false</playerSelectable>
        <effects>
          <li Class="DreamsOutposts.OutpostEventEffect_AddItem">
            <thingDef>Steel</thingDef>
            <count>50</count>
          </li>
        </effects>
      </li>
    </options>
    <defaultOptionId>default</defaultOptionId>
    <durationTicks>60000</durationTicks>
  </DreamsOutposts.OutpostEventDef>
  <DreamsOutposts.OutpostEventDef>
    <defName>DO_IndustrialEventB</defName>
    <label>industrial event B</label>
    <description>A second industrial test event.</description>
    <category>DreamsOutposts_Industrial</category>
    <weight>3</weight>
    <options>
      <li>
        <id>default</id>
        <label>Continue</label>
        <playerSelectable>false</playerSelectable>
      </li>
    </options>
    <defaultOptionId>default</defaultOptionId>
    <durationTicks>60000</durationTicks>
  </DreamsOutposts.OutpostEventDef>
</Defs>
