<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <DreamsOutposts.OutpostFacilityDef>
    <defName>DreamsOutposts_ResearchStation</defName>
    <category>DreamsOutposts_CategoryOther</category>
    <label>research station</label>
    <description>A permanent research operation that contributes 61.875 research points to the colony's current project every half-day.</description>
    <installableAsExtension>false</installableAsExtension>
    <comps>
      <li Class="DreamsOutposts.OutpostFacilityCompProperties_Research">
        <capacityStat>ResearchSpeed</capacityStat>
        <intervalTicks>30000</intervalTicks>
        <outputPerCapacity>6.1875</outputPerCapacity>
        <tags>
          <li>Research</li>
        </tags>
      </li>
    </comps>
  </DreamsOutposts.OutpostFacilityDef>

  <DreamsOutposts.OutpostFacilityDef>
    <defName>DreamsOutposts_AdvancedResearchApparatus</defName>
    <facilityTag>ProductionBoost</facilityTag>
    <category>DreamsOutposts_CategoryProductionBoost</category>
    <label>advanced research apparatus</label>
    <description>A high-tech research installation that multiplies research output by 1.33.</description>
    <allowedOutpostTypes>
      <li>DreamsOutposts_Research</li>
    </allowedOutpostTypes>
    <whitelistOnly>true</whitelistOnly>
    <maxPerOutpost>1</maxPerOutpost>
    <minOutpostLevel>2</minOutpostLevel>
    <buildCost>
      <Steel>250</Steel>
      <ComponentIndustrial>10</ComponentIndustrial>
    </buildCost>
    <productionModifiers>
      <li>
        <productionTag>Research</productionTag>
        <factor>1.33</factor>
      </li>
    </productionModifiers>
  </DreamsOutposts.OutpostFacilityDef>

  <DreamsOutposts.OutpostFacilityDef>
    <defName>DreamsOutposts_SterileAnalysisApparatus</defName>
    <facilityTag>ProductionBoost</facilityTag>
    <category>DreamsOutposts_CategoryProductionBoost</category>
    <label>sterile analysis apparatus</label>
    <description>A sterile analytical suite that multiplies research output by 1.3.</description>
    <allowedOutpostTypes>
      <li>DreamsOutposts_Research</li>
    </allowedOutpostTypes>
    <whitelistOnly>true</whitelistOnly>
    <maxPerOutpost>1</maxPerOutpost>
    <minOutpostLevel>3</minOutpostLevel>
    <buildCost>
      <Steel>100</Steel>
      <Silver>240</Silver>
      <Plasteel>50</Plasteel>
      <Gold>20</Gold>
      <ComponentIndustrial>8</ComponentIndustrial>
    </buildCost>
    <productionModifiers>
      <li>
        <productionTag>Research</productionTag>
        <factor>1.3</factor>
      </li>
    </productionModifiers>
  </DreamsOutposts.OutpostFacilityDef>
</Defs>