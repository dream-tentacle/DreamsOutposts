<Defs>
  <DreamsOutposts.OutpostFacilityDef Name="DreamsOutposts_ResourceBoostBase" Abstract="True"><installableAsExtension>true</installableAsExtension><facilityTag>ProductionBoost</facilityTag><maxPerOutpost>1</maxPerOutpost></DreamsOutposts.OutpostFacilityDef>
