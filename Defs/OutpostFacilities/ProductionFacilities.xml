  <DreamsOutposts.OutpostFacilityDef ParentName="DreamsOutposts_ResourceBoostBase"><defName>DreamsOutposts_OreSortingStation</defName><label>ore sorting station</label><description>Sorts and grades incoming ore, increasing steel output by 50%.</description><allowedOutpostTypes><li>DreamsOutposts_Mining</li></allowedOutpostTypes><buildCost><Steel>150</Steel><ComponentIndustrial>3</ComponentIndustrial></buildCost><productionModifiers><li><productionTag>Mining</productionTag><factor>1.5</factor></li></productionModifiers></DreamsOutposts.OutpostFacilityDef>
  <DreamsOutposts.OutpostFacilityDef ParentName="DreamsOutposts_AdvancedResourceBoostBase"><defName>DreamsOutposts_AdvancedOreSortingStation</defName><label>advanced ore sorting station</label><description>Automated separation equipment doubles steel output.</description><allowedOutpostTypes><li>DreamsOutposts_Mining</li></allowedOutpostTypes><researchPrerequisites><li>Fabrication</li></researchPrerequisites><buildCost><Steel>300</Steel><ComponentIndustrial>8</ComponentIndustrial></buildCost><productionModifiers><li><productionTag>Mining</productionTag><factor>2</factor></li></productionModifiers></DreamsOutposts.OutpostFacilityDef>
  <DreamsOutposts.OutpostFacilityDef ParentName="DreamsOutposts_ResourceBoostBase"><defName>DreamsOutposts_IrrigationSystem</defName><label>irrigation system</label><description>Ditches and pumps increase crop output by 50%.</description><allowedOutpostTypes><li>DreamsOutposts_Farming</li></allowedOutpostTypes><buildCost><Steel>100</Steel><ComponentIndustrial>2</ComponentIndustrial></buildCost><productionModifiers><li><productionTag>Farming</productionTag><factor>1.5</factor></li></productionModifiers></DreamsOutposts.OutpostFacilityDef>
  <DreamsOutposts.OutpostFacilityDef ParentName="DreamsOutposts_AdvancedResourceBoostBase"><defName>DreamsOutposts_AdvancedIrrigationSystem</defName><label>advanced irrigation system</label><description>Automated irrigation and field controls double crop output.</description><allowedOutpostTypes><li>DreamsOutposts_Farming</li></allowedOutpostTypes><researchPrerequisites><li>Fabrication</li></researchPrerequisites><buildCost><Steel>220</Steel><ComponentIndustrial>6</ComponentIndustrial></buildCost><productionModifiers><li><productionTag>Farming</productionTag><factor>2</factor></li></productionModifiers></DreamsOutposts.OutpostFacilityDef>
  <DreamsOutposts.OutpostFacilityDef ParentName="DreamsOutposts_ResourceBoostBase"><defName>DreamsOutposts_MechanizedLoggingStation</defName><label>mechanized logging station</label><description>Powered saws and winches increase timber output by 50%.</description><allowedOutpostTypes><li>DreamsOutposts_Logging</li></allowedOutpostTypes><buildCost><Steel>150</Steel><ComponentIndustrial>3</ComponentIndustrial></buildCost><productionModifiers><li><productionTag>Logging</productionTag><factor>1.5</factor></li></productionModifiers></DreamsOutposts.OutpostFacilityDef>
  <DreamsOutposts.OutpostFacilityDef ParentName="DreamsOutposts_AdvancedResourceBoostBase"><defName>DreamsOutposts_AdvancedLoggingStation</defName><label>advanced mechanized logging station</label><description>Heavy forestry machinery doubles timber output.</description><allowedOutpostTypes><li>DreamsOutposts_Logging</li></allowedOutpostTypes><researchPrerequisites><li>Fabrication</li></researchPrerequisites><buildCost><Steel>300</Steel><ComponentIndustrial>8</ComponentIndustrial></buildCost><productionModifiers><li><productionTag>Logging</productionTag><factor>2</factor></li></productionModifiers></DreamsOutposts.OutpostFacilityDef>
  <DreamsOutposts.OutpostFacilityDef ParentName="DreamsOutposts_ResourceBoostBase"><defName>DreamsOutposts_BoosterPump</defName><label>booster pump</label><description>Additional pumps increase chemfuel output by 50%.</description><allowedOutpostTypes><li>DreamsOutposts_Drilling</li></allowedOutpostTypes><buildCost><Steel>180</Steel><ComponentIndustrial>4</ComponentIndustrial></buildCost><productionModifiers><li><productionTag>Drilling</productionTag><factor>1.5</factor></li></productionModifiers></DreamsOutposts.OutpostFacilityDef>
  <DreamsOutposts.OutpostFacilityDef ParentName="DreamsOutposts_AdvancedResourceBoostBase"><defName>DreamsOutposts_AdvancedBoosterPump</defName><label>advanced booster pump</label><description>A high-pressure pumping system doubles chemfuel output.</description><allowedOutpostTypes><li>DreamsOutposts_Drilling</li></allowedOutpostTypes><researchPrerequisites><li>Fabrication</li></researchPrerequisites><buildCost><Steel>350</Steel><ComponentIndustrial>10</ComponentIndustrial></buildCost><productionModifiers><li><productionTag>Drilling</productionTag><factor>2</factor></li></productionModifiers></DreamsOutposts.OutpostFacilityDef>
  <DreamsOutposts.OutpostFacilityDef ParentName="DreamsOutposts_ResourceBoostBase"><defName>DreamsOutposts_ChemicalPurifier</defName><label>chemical purification equipment</label><description>Improved separation equipment increases neutroamine output by 50%.</description><allowedOutpostTypes><li>DreamsOutposts_Neutroamine</li></allowedOutpostTypes><buildCost><Steel>150</Steel><ComponentIndustrial>4</ComponentIndustrial></buildCost><productionModifiers><li><productionTag>Neutroamine</productionTag><factor>1.5</factor></li></productionModifiers></DreamsOutposts.OutpostFacilityDef>
  <DreamsOutposts.OutpostFacilityDef ParentName="DreamsOutposts_AdvancedResourceBoostBase"><defName>DreamsOutposts_AdvancedChemicalPurifier</defName><label>advanced chemical purification equipment</label><description>Industrial chemical separation doubles neutroamine output.</description><allowedOutpostTypes><li>DreamsOutposts_Neutroamine</li></allowedOutpostTypes><researchPrerequisites><li>DrugProduction</li></researchPrerequisites><buildCost><Steel>300</Steel><ComponentIndustrial>8</ComponentIndustrial></buildCost><productionModifiers><li><productionTag>Neutroamine</productionTag><factor>2</factor></li></productionModifiers></DreamsOutposts.OutpostFacilityDef>
  <DreamsOutposts.OutpostFacilityDef><defName>DreamsOutposts_ComponentsWorkshop</defName><facilityTag>Processing</facilityTag><label>component workshop</label><description>A workshop that machines steel stock into components.</description><researchPrerequisites><li>Fabrication</li></researchPrerequisites><buildCost><Steel>200</Steel><ComponentIndustrial>12</ComponentIndustrial><ComponentSpacer>2</ComponentSpacer></buildCost><productions><li><id>components</id><product>ComponentIndustrial</product><capacityStat>DreamsOutposts_SmithingSpeed</capacityStat><intervalTicks>60000</intervalTicks><outputPerCapacity>4</outputPerCapacity><requiredSkill>Crafting</requiredSkill><requiredSkillLevel>8</requiredSkillLevel><inputs><Steel>12</Steel></inputs></li></productions></DreamsOutposts.OutpostFacilityDef>
  <DreamsOutposts.OutpostFacilityDef><defName>DreamsOutposts_AdvancedComponentsWorkshop</defName><facilityTag>Processing</facilityTag><label>advanced component workshop</label><description>A precision workshop that produces advanced components from their standard materials.</description><researchPrerequisites><li>AdvancedFabrication</li></researchPrerequisites><buildCost><Steel>300</Steel><ComponentIndustrial>15</ComponentIndustrial><ComponentSpacer>4</ComponentSpacer></buildCost><productions><li><id>advancedComponents</id><product>ComponentSpacer</product><capacityStat>DreamsOutposts_SmithingSpeed</capacityStat><intervalTicks>60000</intervalTicks><outputPerCapacity>2</outputPerCapacity><requiredSkill>Crafting</requiredSkill><requiredSkillLevel>8</requiredSkillLevel><inputs><ComponentIndustrial>1</ComponentIndustrial><Steel>20</Steel><Plasteel>10</Plasteel><Gold>3</Gold></inputs></li></productions></DreamsOutposts.OutpostFacilityDef>
  <DreamsOutposts.OutpostFacilityDef><defName>DreamsOutposts_MedicineWorkshop</defName><facilityTag>Processing</facilityTag><label>medicine workshop</label><description>A clean pharmaceutical workspace that processes cloth, herbal medicine and neutroamine into industrial medicine.</description><researchPrerequisites><li>MedicineProduction</li></researchPrerequisites><buildCost><Steel>180</Steel><ComponentIndustrial>8</ComponentIndustrial></buildCost><productions><li><id>medicine</id><product>MedicineIndustrial</product><capacityStat>DrugSynthesisSpeed</capacityStat><intervalTicks>60000</intervalTicks><outputPerCapacity>28.5</outputPerCapacity><requiredSkill>Intellectual</requiredSkill><requiredSkillLevel>4</requiredSkillLevel><inputs><Cloth>3</Cloth><MedicineHerbal>1</MedicineHerbal><Neutroamine>1</Neutroamine></inputs></li></productions></DreamsOutposts.OutpostFacilityDef>
  <DreamsOutposts.OutpostFacilityDef><defName>DreamsOutposts_CompactMiningMachine</defName><facilityTag>AutomaticProduction</facilityTag><label>compact mining machine</label><description>A compact automated miner that steadily extracts steel without requiring a resident operator.</description><maxPerOutpost>1</maxPerOutpost><buildCost><Steel>150</Steel></buildCost><productions><li><id>automaticSteel</id><product>Steel</product><intervalTicks>60000</intervalTicks><outputPerCapacity>63.16</outputPerCapacity></li></productions></DreamsOutposts.OutpostFacilityDef>
  <DreamsOutposts.OutpostFacilityDef><defName>DreamsOutposts_AutomaticReactor</defName><facilityTag>AutomaticProduction</facilityTag><label>automatic reaction vessel</label><description>An automated chemical reactor that continuously produces chemfuel.</description><maxPerOutpost>1</maxPerOutpost><researchPrerequisites><li>BiofuelRefining</li></researchPrerequisites><buildCost><Steel>75</Steel><Chemfuel>50</Chemfuel></buildCost><productions><li><id>automaticChemfuel</id><product>Chemfuel</product><intervalTicks>60000</intervalTicks><outputPerCapacity>52.17</outputPerCapacity></li></productions></DreamsOutposts.OutpostFacilityDef>
  <DreamsOutposts.OutpostFacilityDef><defName>DreamsOutposts_ChemicalCollectionDevice</defName><facilityTag>AutomaticProduction</facilityTag><label>chemical collection device</label><description>An automated chemical collector that refines trace precursors into neutroamine.</description><maxPerOutpost>1</maxPerOutpost><researchPrerequisites><li>MedicineProduction</li></researchPrerequisites><buildCost><Steel>75</Steel><Neutroamine>15</Neutroamine></buildCost><productions><li><id>automaticNeutroamine</id><product>Neutroamine</product><intervalTicks>60000</intervalTicks><outputPerCapacity>20</outputPerCapacity></li></productions></DreamsOutposts.OutpostFacilityDef>
  <DreamsOutposts.OutpostFacilityDef><defName>DreamsOutposts_DeepPlasteelDrill</defName><facilityTag>AutomaticProduction</facilityTag><label>deep plasteel drill</label><description>A specialized deep drill that slowly extracts plasteel deposits.</description><maxPerOutpost>1</maxPerOutpost><researchPrerequisites><li>Machining</li></researchPrerequisites><buildCost><Steel>40</Steel><Plasteel>40</Plasteel><ComponentIndustrial>5</ComponentIndustrial></buildCost><productions><li><id>automaticPlasteel</id><product>Plasteel</product><intervalTicks>60000</intervalTicks><outputPerCapacity>13.33</outputPerCapacity></li></productions></DreamsOutposts.OutpostFacilityDef>
  <DreamsOutposts.OutpostFacilityDef><defName>DreamsOutposts_PreciousMetalSeparator</defName><facilityTag>AutomaticProduction</facilityTag><label>precious metal separator</label><description>A precision separator that recovers small quantities of gold from low-grade material.</description><maxPerOutpost>1</maxPerOutpost><researchPrerequisites><li>Fabrication</li></researchPrerequisites><buildCost><Steel>20</Steel><Plasteel>10</Plasteel><ComponentIndustrial>5</ComponentIndustrial><ComponentSpacer>1</ComponentSpacer></buildCost><productions><li><id>automaticGold</id><product>Gold</product><intervalTicks>60000</intervalTicks><outputPerCapacity>12</outputPerCapacity></li></productions></DreamsOutposts.OutpostFacilityDef>
  <DreamsOutposts.OutpostFacilityDef><defName>DreamsOutposts_CottonGreenhouse</defName><facilityTag>AutomaticProduction</facilityTag><label>cotton greenhouse</label><description>A mechanized greenhouse that continuously cultivates and processes cotton into cloth.</description><maxPerOutpost>1</maxPerOutpost><researchPrerequisites><li>Machining</li></researchPrerequisites><buildCost><Steel>100</Steel><ComponentIndustrial>10</ComponentIndustrial></buildCost><productions><li><id>automaticCloth</id><product>Cloth</product><intervalTicks>60000</intervalTicks><outputPerCapacity>63.16</outputPerCapacity></li></productions></DreamsOutposts.OutpostFacilityDef>
  <DreamsOutposts.OutpostFacilityDef><defName>DreamsOutposts_HerbalGreenhouse</defName><facilityTag>AutomaticProduction</facilityTag><label>herbal greenhouse</label><description>A controlled greenhouse that continuously cultivates and harvests medicinal herbs.</description><maxPerOutpost>1</maxPerOutpost><researchPrerequisites><li>Machining</li></researchPrerequisites><buildCost><Steel>100</Steel><ComponentIndustrial>10</ComponentIndustrial></buildCost><productions><li><id>automaticHerbalMedicine</id><product>MedicineHerbal</product><intervalTicks>60000</intervalTicks><outputPerCapacity>12</outputPerCapacity></li></productions></DreamsOutposts.OutpostFacilityDef>
  <DreamsOutposts.OutpostFacilityDef><defName>DreamsOutposts_AdaptiveMiningMachine</defName><facilityTag>AutomaticProduction</facilityTag><label>adaptive mining machine</label><description>An advanced automated miner that can be configured to extract different mineral resources.</description><maxPerOutpost>1</maxPerOutpost><researchPrerequisites><li>Fabrication</li></researchPrerequisites><buildCost><Steel>40</Steel><Plasteel>5</Plasteel><ComponentSpacer>3</ComponentSpacer></buildCost><productions><li Class="DreamsOutposts.OutpostProductionProperties_AdaptiveMining"><id>adaptiveMineral</id><intervalTicks>60000</intervalTicks><dailyMarketValue>100</dailyMarketValue></li></productions></DreamsOutposts.OutpostFacilityDef>
  <DreamsOutposts.OutpostFacilityDef><defName>DreamsOutposts_AutomaticAirdropper</defName><facilityTag>Other</facilityTag><uiIcon>Crate</uiIcon><label>automatic airdropper</label><description>Routes selected facility outputs directly to the primary colony by drop pod.</description><maxPerOutpost>1</maxPerOutpost><researchPrerequisites><li>TransportPod</li></researchPrerequisites><buildCost><Steel>200</Steel><ComponentIndustrial>6</ComponentIndustrial></buildCost><automaticAirdropController>true</automaticAirdropController></DreamsOutposts.OutpostFacilityDef>
  <DreamsOutposts.OutpostFacilityDef><defName>DreamsOutposts_WoodPowerGenerator</defName><facilityTag>AutomaticProduction</facilityTag><uiIcon>Generator</uiIcon><label>wood-fired outpost generator</label><description>A remote generator that prepays its fuel and transmits power to a linked receiver.</description><maxPerOutpost>1</maxPerOutpost><researchPrerequisites><li>Fabrication</li></researchPrerequisites><buildCost><Steel>100</Steel><ComponentIndustrial>2</ComponentIndustrial></buildCost><productions><li Class="DreamsOutposts.OutpostProductionProperties_Power"><id>remoteWoodPower</id><outputLabelKey>DreamsOutposts.RemotePower.PowerOutput</outputLabelKey><intervalTicks>60000</intervalTicks><workerClass>DreamsOutposts.OutpostProductionWorker_Power</workerClass><fuel>WoodLog</fuel><fuelPerCycle>22</fuelPerCycle><fuelDurationTicks>60000</fuelDurationTicks><basePowerOutput>1000</basePowerOutput></li></productions></DreamsOutposts.OutpostFacilityDef>
  <DreamsOutposts.OutpostFacilityDef><defName>DreamsOutposts_ChemfuelPowerGenerator</defName><facilityTag>AutomaticProduction</facilityTag><uiIcon>Generator</uiIcon><label>chemfuel outpost generator</label><description>A remote generator that consumes nine chemfuel before transmitting power for two days.</description><maxPerOutpost>1</maxPerOutpost><researchPrerequisites><li>Fabrication</li></researchPrerequisites><buildCost><Steel>100</Steel><ComponentIndustrial>3</ComponentIndustrial></buildCost><productions><li Class="DreamsOutposts.OutpostProductionProperties_Power"><id>remoteChemfuelPower</id><outputLabelKey>DreamsOutposts.RemotePower.PowerOutput</outputLabelKey><intervalTicks>120000</intervalTicks><workerClass>DreamsOutposts.OutpostProductionWorker_Power</workerClass><fuel>Chemfuel</fuel><fuelPerCycle>9</fuelPerCycle><fuelDurationTicks>120000</fuelDurationTicks><basePowerOutput>1000</basePowerOutput></li></productions></DreamsOutposts.OutpostFacilityDef>
</Defs>
