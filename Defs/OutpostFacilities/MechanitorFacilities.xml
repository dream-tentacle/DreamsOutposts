    <researchPrerequisites><li>BasicMechtech</li></researchPrerequisites>
    <buildCost><Steel>200</Steel><ComponentIndustrial>4</ComponentIndustrial></buildCost>
    <comps><li Class="DreamsOutposts.OutpostFacilityCompProperties_Bandwidth"><bandwidth>1</bandwidth></li></comps>
  </DreamsOutposts.OutpostFacilityDef>
</Defs>
