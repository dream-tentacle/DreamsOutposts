<?xml version="1.0" encoding="utf-8" ?>
<Defs>


<DreamsOutposts.OutpostFacilityDef>
    <defName>DreamsOutposts_MiningPlant</defName>
    <label>mining plant</label>
    <description>The facility that makes a mining outpost a mining outpost. Ore is dug out and dressed here.</description>
<installableAsExtension>false</installableAsExtension>
    <productions>
      <li>
        <id>steel</id>
        <product>Steel</product>
        <capacityStat>MiningSpeed</capacityStat>
        <intervalTicks>60000</intervalTicks>
        <outputPerCapacity>421</outputPerCapacity>
        <tags>
          <li>Mining</li>
        </tags>
      </li>
    </productions>
  </DreamsOutposts.OutpostFacilityDef>
<DreamsOutposts.OutpostFacilityDef>
    <defName>DreamsOutposts_Farm</defName>
    <label>farm</label>
    <description>Fields and paddies worked by the outpost's residents. The crop is chosen by the player; faster-maturing crops yield more per day than slow, high-value ones.</description>
    <installableAsExtension>false</installableAsExtension>
    <productions>
<li Class="DreamsOutposts.OutpostProductionProperties_Farming">
        <id>crops</id>
        <capacityStat>PlantWorkSpeed</capacityStat>
        <intervalTicks>60000</intervalTicks>
        <outputPerCapacity>160</outputPerCapacity>
<sowTag>Ground</sowTag>
<tags>
          <li>Farming</li>
        </tags>
      </li>
    </productions>
  </DreamsOutposts.OutpostFacilityDef>
<DreamsOutposts.OutpostFacilityDef>
    <defName>DreamsOutposts_LoggingCamp</defName>
    <label>logging camp</label>
    <description>The facility that makes a logging outpost a logging outpost. Timber is felled, trimmed and stacked here.</description>
    <installableAsExtension>false</installableAsExtension>
    <productions>
      <li>
        <id>wood</id>
        <product>WoodLog</product>
        <capacityStat>PlantWorkSpeed</capacityStat>
        <intervalTicks>60000</intervalTicks>
        <outputPerCapacity>625</outputPerCapacity>
        <tags>
          <li>Logging</li>
        </tags>
      </li>
    </productions>
  </DreamsOutposts.OutpostFacilityDef>
<DreamsOutposts.OutpostFacilityDef>
    <defName>DreamsOutposts_OilDerrick</defName>
    <label>oil derrick</label>
    <description>The facility that makes a drilling outpost a drilling outpost. Crude feedstock is pumped up and refined into chemfuel on site.</description>
    <installableAsExtension>false</installableAsExtension>
    <productions>
      <li>
        <id>chemfuel</id>
        <product>Chemfuel</product>
        <capacityStat>ConstructionSpeed</capacityStat>
        <intervalTicks>60000</intervalTicks>
        <outputPerCapacity>350</outputPerCapacity>
        <tags>
          <li>Drilling</li>
        </tags>
      </li>
    </productions>
  </DreamsOutposts.OutpostFacilityDef>
<DreamsOutposts.OutpostFacilityDef>
    <defName>DreamsOutposts_TownCenter</defName>
    <label>town center</label>
    <description>The facility that makes a town outpost a town outpost. It produces nothing on its own - a town is the square, the roads and the people that hold it together, and everything it earns comes from the facilities built around it.</description>
    <installableAsExtension>false</installableAsExtension>
  </DreamsOutposts.OutpostFacilityDef>
<DreamsOutposts.OutpostFacilityDef>
    <defName>DreamsOutposts_OreSortingStation</defName>
    <label>ore sorting station</label>
    <description>Sorts and grades incoming ore, so the mining plant gets more usable material out of the same shift.</description>
    <installableAsExtension>true</installableAsExtension>
    <allowedOutpostTypes>
      <li>DreamsOutposts_Mining</li>
    </allowedOutpostTypes>
    <maxPerOutpost>1</maxPerOutpost>
    <buildCost>
      <Steel>150</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </buildCost>
    <productionModifiers>
      <li>
        <productionTag>Mining</productionTag>
        <factor>1.25</factor>
      </li>
    </productionModifiers>
  </DreamsOutposts.OutpostFacilityDef>

  <DreamsOutposts.OutpostFacilityDef>
    <defName>DreamsOutposts_IrrigationSystem</defName>
    <label>irrigation system</label>
    <description>Ditches and pumps that keep the fields watered, so less of the harvest is lost.</description>
    <installableAsExtension>true</installableAsExtension>
    <allowedOutpostTypes>
      <li>DreamsOutposts_Farming</li>
    </allowedOutpostTypes>
    <maxPerOutpost>1</maxPerOutpost>
    <buildCost>
      <Steel>100</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </buildCost>
    <productionModifiers>
      <li>
        <productionTag>Farming</productionTag>
        <factor>1.25</factor>
      </li>
    </productionModifiers>
  </DreamsOutposts.OutpostFacilityDef>

  <DreamsOutposts.OutpostFacilityDef>
    <defName>DreamsOutposts_MechanizedLoggingStation</defName>
    <label>mechanized logging station</label>
    <description>Powered saws and winches that get more usable timber out of every felled tree.</description>
    <installableAsExtension>true</installableAsExtension>
    <allowedOutpostTypes>
      <li>DreamsOutposts_Logging</li>
    </allowedOutpostTypes>
    <maxPerOutpost>1</maxPerOutpost>
    <buildCost>
      <Steel>150</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </buildCost>
    <productionModifiers>
      <li>
        <productionTag>Logging</productionTag>
        <factor>1.25</factor>
      </li>
    </productionModifiers>
  </DreamsOutposts.OutpostFacilityDef>

  <DreamsOutposts.OutpostFacilityDef>
    <defName>DreamsOutposts_BoosterPump</defName>
    <label>booster pump</label>
    <description>A second set of pumps that keeps pressure up in the well, raising the flow of feedstock.</description>
    <installableAsExtension>true</installableAsExtension>
    <allowedOutpostTypes>
      <li>DreamsOutposts_Drilling</li>
    </allowedOutpostTypes>
    <maxPerOutpost>1</maxPerOutpost>
    <buildCost>
      <Steel>180</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </buildCost>
    <productionModifiers>
      <li>
        <productionTag>Drilling</productionTag>
        <factor>1.25</factor>
      </li>
    </productionModifiers>
  </DreamsOutposts.OutpostFacilityDef>

<DreamsOutposts.OutpostFacilityDef>
    <defName>DreamsOutposts_ComponentsWorkshop</defName>
    <label>component workshop</label>
    <description>A workshop that machines steel stock into components. Only skilled craftsmen are trusted with it.</description>
    <installableAsExtension>true</installableAsExtension>
    <researchPrerequisites>
      <li>Fabrication</li>
    </researchPrerequisites>
    <buildCost>
      <Steel>200</Steel>
      <ComponentIndustrial>12</ComponentIndustrial>
      <ComponentSpacer>2</ComponentSpacer>
    </buildCost>
    <eventCategoryModifiers>
      <li>
        <category>DreamsOutposts_Industrial</category>
        <offset>10</offset>
      </li>
    </eventCategoryModifiers>
    <productions>
      <li>
        <id>components</id>
        <product>ComponentIndustrial</product>
        <capacityStat>DreamsOutposts_SmithingSpeed</capacityStat>
        <intervalTicks>60000</intervalTicks>
        <outputPerCapacity>4</outputPerCapacity>
        <requiredSkill>Crafting</requiredSkill>
        <requiredSkillLevel>8</requiredSkillLevel>
<inputs>
          <Steel>12</Steel>
        </inputs>
      </li>
    </productions>
  </DreamsOutposts.OutpostFacilityDef>
<DreamsOutposts.OutpostFacilityDef>
    <defName>DreamsOutposts_MortarEmplacement</defName>
    <label>mortar emplacement</label>
    <description>A permanent mortar pit, dug in behind the outpost's perimeter and worked by a crew that never leaves. Range tables, a stock of shells and a telephone line are all it needs to drop high-explosive fire on any map within reach.</description>
    <installableAsExtension>true</installableAsExtension>
    <maxPerOutpost>1</maxPerOutpost>
    <researchPrerequisites>
      <li>Mortars</li>
    </researchPrerequisites>
    <buildCost>
      <Steel>150</Steel>
      <ComponentIndustrial>6</ComponentIndustrial>
    </buildCost>
    <bombardment>
      <shellDef>Shell_HighExplosive</shellDef>
      <shellsPerStrike>4</shellsPerStrike>
      <costPerShell>
        <Steel>30</Steel>
        <Chemfuel>18</Chemfuel>
      </costPerShell>
      <maxRangeTiles>12</maxRangeTiles>
      <cooldownHours>18</cooldownHours>
      <researchPrerequisite>Mortars</researchPrerequisite>
      <ticksBetweenShells>60</ticksBetweenShells>
      <requiredSkill>Shooting</requiredSkill>
      <requiredSkillLevel>10</requiredSkillLevel>
    </bombardment>
  </DreamsOutposts.OutpostFacilityDef>

  <DreamsOutposts.OutpostFacilityDef>
    <defName>DreamsOutposts_AmmunitionDump</defName>
    <label>ammunition dump</label>
    <description>Crates of shells, kept dry, counted twice and stacked to the ceiling. Every bombardment this outpost fires can throw three more shells before the crews have to slow down.</description>
    <installableAsExtension>true</installableAsExtension>
    <researchPrerequisites>
      <li>Mortars</li>
    </researchPrerequisites>
    <buildCost>
      <Steel>100</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </buildCost>
    <bombardmentShellBonus>3</bombardmentShellBonus>
  </DreamsOutposts.OutpostFacilityDef>
<DreamsOutposts.OutpostFacilityDef>
    <defName>DreamsOutposts_Warehouse</defName>
    <label>warehouse</label>
    <description>A plain storage building. Salvaged goods are sorted and repacked here.</description>
    <installableAsExtension>true</installableAsExtension>
    <productions>
      <li>
        <id>repacking</id>
        <product>WoodLog</product>
        <capacityStat>GeneralLaborSpeed</capacityStat>
        <intervalTicks>60000</intervalTicks>
        <outputPerCapacity>40</outputPerCapacity>
      </li>
    </productions>
  </DreamsOutposts.OutpostFacilityDef>
</Defs>
